# ---- Database ----
# Production: shared Postgres on the VPS, root_default network.
# Local dev: see DEPLOY.md for a quick docker run.
DATABASE_URL=postgresql://sepnexus:CHANGE_ME@postgresql:5432/sepnexus

# ---- App config ----
# The public hostname Traefik routes to this app.
PUBLIC_HOST=sepnexus.com
PUBLIC_BASE_URL=https://sepnexus.com

# ---- Auth ----
# 32+ random chars. Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Seeded the first time the app boots if no users exist.
# Change the password after first login (User → Change password).
ADMIN_EMAIL=akshay@sepnexus.com
ADMIN_PASSWORD=change-me-on-first-login

# ---- Email (Resend) ----
RESEND_API_KEY=re_change_me
EMAIL_FROM="Sepnexus <noreply@sepnexus.com>"
EMAIL_REPLY_TO=akshay@sepnexus.com

# ---- Razorpay (test keys until cutover) ----
RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me

# ---- Usage ingestion + cron ----
# n8n's lifecycle webhook sends executions to /api/usage/exec with this Bearer token.
USAGE_INGEST_SECRET=set-a-32-char-random-string
# /api/cron/period-close requires this Bearer token. Used by an hourly cron on the VPS.
CRON_SECRET=set-a-32-char-random-string

# ---- Boot behavior ----
RUN_MIGRATIONS_ON_BOOT=1
